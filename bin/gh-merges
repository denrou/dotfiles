#!/usr/bin/env bash
# Approve and squash-merge one or more PRs.
#
# Usage: gh merges [-R|--repo OWNER/REPO] [--admin|--auto] <PR-number>...
#
# For each PR:
#   gh pr review --approve <PR>
#   gh pr merge --squash --delete-branch [--admin|--auto] <PR>
set -eo pipefail

usage() {
    grep '^#' "$0" | sed 's/^# \{0,1\}//' | tail -n +2
}

repo_args=()
merge_flags=()
prs=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -R|--repo)
            [[ $# -ge 2 ]] || { echo "error: $1 requires a value" >&2; exit 1; }
            repo_args=(--repo "$2")
            shift 2
            ;;
        --repo=*|-R=*)
            repo_args=("--repo" "${1#*=}")
            shift
            ;;
        --admin|--auto)
            merge_flags+=("$1")
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            prs+=("$1")
            shift
            ;;
    esac
done

if [[ ${#prs[@]} -eq 0 ]]; then
    echo "error: no PR numbers given" >&2
    usage >&2
    exit 1
fi

for pr in "${prs[@]}"; do
    echo "==> PR #$pr: approving"
    gh pr review --approve "$pr" ${repo_args[@]+"${repo_args[@]}"}
    echo "==> PR #$pr: merging (squash, delete branch)"
    gh pr merge --squash --delete-branch ${merge_flags[@]+"${merge_flags[@]}"} "$pr" ${repo_args[@]+"${repo_args[@]}"}
done
